rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The two people allowed to write to the ledger.
    // email_verified guards against a future Email/Password provider being
    // used to register one of these addresses without owning it.
    function isLedgerOwner() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.email in [
             'voxtel@gmail.com',
             'deeanna.d.lodzeischi@gmail.com'
           ];
    }

    // Keep this list in sync with src/data/categories.js. A unit test asserts
    // that every id defined there also appears in this file.
    function isValidCategory(category) {
      return category in [
        'chores', 'allowance', 'gift', 'bonus', 'school',
        'toys', 'games', 'books', 'treats', 'outings', 'savings', 'giving',
        'uncategorized'
      ];
    }

    // Fields every transaction carries, whether new or edited. amountMinor is
    // an integer number of hundredths, never a float: money summed as floats
    // drifts, and a decimal check in rules is unreliable because 10.07 * 100
    // is 1006.9999999999999.
    function hasValidCore(d) {
      return d.amountMinor is int
        && d.amountMinor != 0
        && math.abs(d.amountMinor) <= 100000000
        && isValidCategory(d.category)
        && d.comment is string
        && d.comment.size() <= 500;
    }

    // A new transaction: authored by the caller, stamped by the server.
    function isValidCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(['amountMinor', 'comment', 'category', 'user', 'timestamp'])
        && d.keys().hasAll(['amountMinor', 'comment', 'category', 'user', 'timestamp'])
        && hasValidCore(d)
        && d.user == request.auth.token.email
        && d.timestamp == request.time;
    }

    // An edit may change what was recorded, never who recorded it or when.
    // Rewriting timestamp here would silently move the entry's date, so both
    // it and the original author are pinned to their existing values.
    function isValidUpdate() {
      let d = request.resource.data;
      let prior = resource.data;
      return d.keys().hasOnly(['amountMinor', 'comment', 'category', 'user', 'timestamp', 'editedBy', 'editedAt'])
        && d.keys().hasAll(['amountMinor', 'comment', 'category', 'user', 'timestamp', 'editedBy', 'editedAt'])
        && hasValidCore(d)
        && d.user == prior.user
        && d.timestamp == prior.timestamp
        && d.editedBy == request.auth.token.email
        && d.editedAt == request.time;
    }

    match /transactions/{transactionId} {
      // Public by design: the running total and ledger are readable by
      // anyone, including signed-out visitors. This is what keeps CoinCount
      // working before login.
      allow read: if true;

      allow create: if isLedgerOwner() && isValidCreate();
      allow update: if isLedgerOwner() && isValidUpdate();
      allow delete: if isLedgerOwner();
    }

    // Everything else is denied by default, rather than inheriting the
    // previous catch-all match /{document=**}.
  }
}
